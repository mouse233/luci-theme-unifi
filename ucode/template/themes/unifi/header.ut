{%
	import { getuid, getspnam } from 'luci.core';
	import { cursor } from 'uci';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const prefs = cursor().get_all('unifi', 'theme') ?? {};
	const mode = (prefs.mode == 'auto' || prefs.mode == 'light' || prefs.mode == 'dark') ? prefs.mode : 'auto';
	const page_size = (prefs.page_size == '10' || prefs.page_size == '25' || prefs.page_size == '50' || prefs.page_size == '100') ? prefs.page_size : '50';
	const client_refresh = (prefs.client_refresh == '5' || prefs.client_refresh == '10' || prefs.client_refresh == '30' || prefs.client_refresh == '60') ? prefs.client_refresh : '10';
	const dashboard_refresh = (prefs.dashboard_refresh in ['1', '2', '5', '10', '30', '60']) ? prefs.dashboard_refresh : '1';
	const activity_always = (prefs.activity_always in ['0', '1']) ? prefs.activity_always : '1';

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-uf-mode="{{ mode }}" data-darkmode="{{ mode == 'dark' ? 'true' : 'false' }}" data-uf-page-size="{{ page_size }}" data-uf-client-refresh="{{ client_refresh }}" data-uf-dashboard-refresh="{{ dashboard_refresh }}" data-uf-nav-expanded="{{ prefs.nav_expanded == '1' ? '1' : '0' }}" data-uf-activity-always="{{ activity_always }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` - ${_(dispatched.title)}` : ''}`) }} - LuCI</title>
		<script src="{{ media }}/appearance.js{# ?v=PKG_VERSION #}"></script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="stylesheet" href="{{ media }}/cascade.css{# ?v=PKG_VERSION #}">
		<link rel="stylesheet" href="{{ media }}/controls.css{# ?v=PKG_VERSION #}">
		<link rel="stylesheet" href="{{ media }}/layout.css{# ?v=PKG_VERSION #}">
		<link rel="stylesheet" href="{{ media }}/icons.css{# ?v=PKG_VERSION #}">
		<link rel="stylesheet" media="only screen and (max-device-width: 854px)" href="{{ media }}/mobile.css{# ?v=PKG_VERSION #}" type="text/css" />
		{% if (blank_page): %}
		<link rel="stylesheet" href="{{ media }}/login.css{# ?v=PKG_VERSION #}">
		{% endif %}
		<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
	</head>

	<body class="uf-theme {{ blank_page ? 'uf-login' : '' }} lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<header>
			<a class="brand" href="{{ dispatcher.build_url('admin/unifi-dashboard') }}"><img src="{{ media }}/logo.svg" alt=""><span>{{ striptags(boardinfo.hostname ?? 'OpenWrt') }}</span></a>
			<span id="uf-page-title">OpenWrt</span>
			<ul class="nav" id="topmenu" style="display:none"></ul>
			<div id="indicators" class="pull-right"></div>
		</header>

		<div id="maincontent" class="container">
			{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="alert-message warning">
					<h4>{{ _('No password set!') }}</h4>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					{% if (dispatcher.lookup("admin/system/admin")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			{% if (boardinfo.rootfs_type == "initramfs"): %}
				<div class="alert-message warning">
					<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
					{% if (dispatcher.lookup("admin/system/flash")): %}
					  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
					{% endif %}
				</div>
			{% endif %}

			<noscript>
				<div class="alert-message warning">
					<h4>{{ _('JavaScript required!') }}</h4>
					<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
				</div>
			</noscript>

			<div id="tabmenu" style="display:none"></div>
		{% endif %}
