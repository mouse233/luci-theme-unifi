#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
START=95
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p -m 700 /var/run/unifi-presence
	chmod 700 /var/run/unifi-presence
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/unifi/presence.uc
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger unifi dhcp network
}
reload_service() {
	stop
	start
}
